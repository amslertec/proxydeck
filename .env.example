# ProxyDeck - Umgebungsvariablen
# Kopiere diese Datei zu .env und passe die Werte an
# cp .env.example .env
#
# ⚠️  SICHERHEITSWARNUNG ⚠️
# NIEMALS .env in Git committen - enthält sensible Credentials!

# ─────────────────────────────────────────────────────────────
# DOCKER IMAGE VERSION
# ─────────────────────────────────────────────────────────────

# Docker Image Tag (Standard: latest)
# Verfügbare Tags: latest, v0.1.0, v0.1.1, etc.
# Semantic Versioning: v0.x.x (Beta), v1.x.x (Stable)
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────
# PFLICHTFELDER (ohne diese startet der Container nicht)
# ─────────────────────────────────────────────────────────────

# Admin-Benutzer für das Dashboard
ADMIN_USER=admin

# 🔐 SICHERHEIT: Nutze Docker Secrets für Production!
# Admin-Passwort - Generieren mit: openssl rand -base64 32
ADMIN_PASS=CHANGE_ME_SECURE_PASSWORD

# 🔐 SICHERHEIT: Nutze Docker Secrets für Production!
# JWT Secret für Session-Tokens (mindestens 64 Zeichen!)
# Generieren mit: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64_TO_GENERATE_THIS_VALUE

# 🔐 SICHERHEIT: Nutze Docker Secrets für Production!
# MFA Encryption Key (bleibt stabil bei JWT-Rotation, mindestens 64 Zeichen!)
# Generieren mit: openssl rand -hex 64
MFA_ENCRYPTION_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_64_TO_GENERATE_THIS_VALUE

# ─────────────────────────────────────────────────────────────
# OPTIONALE FELDER
# ─────────────────────────────────────────────────────────────

# Zeitzone (Standard: Europe/Zurich)
TZ=Europe/Zurich

# Admin E-Mail für Benachrichtigungen
ADMIN_EMAIL=

# E-Mail für Let's Encrypt Zertifikate
ACME_EMAIL=

# Let's Encrypt Account ID (optional)
# Wenn mehrere Accounts vorhanden sind, kann hiermit der zu verwendende Account festgelegt werden
# Format: account-hash (z.B. 167f1bc0fac4)
# Leer lassen für automatische Auswahl
ACME_ACCOUNT=

# Secure Cookies (true für HTTPS-only, false für HTTP/IP-Zugriff)
SECURE_COOKIES=false

# Frontend URL (optional): Automatisches Proxy-Setup beim ersten Start
# Beispiel: https://proxydeck.example.com
FRONTEND_URL=

# ─────────────────────────────────────────────────────────────
# PERFORMANCE & FEATURES (optional)
# ─────────────────────────────────────────────────────────────

# HTTP/3 aktivieren (Standard: 1)
# ENABLE_H3=1

# Micro-Cache für anonyme GET/HEAD Requests (Sekunden)
# MICROCACHE_SECS=5

# Isolation Headers (COOP/COEP/CORP) - kann 3rd-party blockieren
# ISOLATION_HEADERS=0

# ─────────────────────────────────────────────────────────────
# DATENBANK (normalerweise nicht ändern)
# ─────────────────────────────────────────────────────────────

# PostgreSQL Verbindung (Container-intern)
# PGHOST=db
# PGUSER=proxydeck
# PGPASSWORD=proxydeck
# PGDATABASE=proxydeck
# PGPORT=5432
