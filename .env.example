# ProxyDeck - Environment Variables
# Copy this file to .env and adjust the values
# cp .env.example .env
#
# ⚠️  SECURITY WARNING ⚠️
# NEVER commit .env to Git - contains sensitive credentials!

# ─────────────────────────────────────────────────────────────
# DOCKER IMAGE VERSION
# ─────────────────────────────────────────────────────────────

# Docker Image Tag (default: latest)
# Available tags: latest, v0.1.0, v0.1.1, etc.
# Semantic Versioning: v0.x.x (Beta), v1.x.x (Stable)
IMAGE_TAG=latest

# ─────────────────────────────────────────────────────────────
# REQUIRED FIELDS (container won't start without these)
# ─────────────────────────────────────────────────────────────

# Admin user for the dashboard
ADMIN_USER=admin

# Admin password - Generate with: openssl rand -base64 32
ADMIN_PASS=CHANGE_ME_SECURE_PASSWORD

# JWT Secret for session tokens (minimum 64 characters!)
# Generate with: openssl rand -hex 64
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_HEX_64_TO_GENERATE_THIS_VALUE

# MFA Encryption Key (remains stable during JWT rotation, minimum 64 characters!)
# Generate with: openssl rand -hex 64
MFA_ENCRYPTION_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_64_TO_GENERATE_THIS_VALUE

# ─────────────────────────────────────────────────────────────
# OPTIONAL FIELDS
# ─────────────────────────────────────────────────────────────

# Timezone (default: Europe/Zurich)
TZ=Europe/Zurich

# Admin email for notifications
ADMIN_EMAIL=

# Email for Let's Encrypt certificates
ACME_EMAIL=

# Let's Encrypt Account ID (optional)
# If multiple accounts exist, specify which account to use
# Format: account-hash (e.g., 167f1bc0fac4)
# Leave empty for automatic selection
ACME_ACCOUNT=

# Secure Cookies (true for HTTPS-only, false for HTTP/IP access)
SECURE_COOKIES=false

# Frontend URL (optional): Automatic proxy setup on first start
# Example: https://proxydeck.example.com
FRONTEND_URL=

# ─────────────────────────────────────────────────────────────
# PERFORMANCE & FEATURES (optional)
# ─────────────────────────────────────────────────────────────

# Enable HTTP/3 (default: 1)
# ENABLE_H3=1

# Micro-cache for anonymous GET/HEAD requests (seconds)
# MICROCACHE_SECS=5

# Isolation Headers (COOP/COEP/CORP) - may block 3rd-party content
# ISOLATION_HEADERS=0

# ─────────────────────────────────────────────────────────────
# DATABASE (usually no changes needed)
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection (container-internal)
# PGHOST=db
# PGUSER=proxydeck
# PGPASSWORD=proxydeck
# PGDATABASE=proxydeck
# PGPORT=5432
